@using Auth.Core.Models;
@model TesterLab.Models.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Gestion des Utilisateurs";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users"></i> Gestion des Utilisateurs</h2>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Nouvel Utilisateur
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Rechercher</label>
                    <input type="text" name="search" class="form-control"
                           placeholder="Nom, email..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Filtrer par rôle</label>
                    <select name="roleFilter" class="form-select">
                        <option value="">Tous les rôles</option>
                        @foreach (var role in ViewBag.AvailableRoles as List<Role>)
                        {
                            <option value="@role.Name" selected="@(Model.RoleFilter == role.Name)">
                                @role.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search"></i> Rechercher
                    </button>
                    <a asp-action="Users" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Réinitialiser
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Liste des utilisateurs -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Email</th>
                            <th>Rôles</th>
                            <th>Statut</th>
                            <th>Dernière connexion</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p>Aucun utilisateur trouvé</p>
                                </td>
                            </tr>
                        }
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div>
                                        <strong>@user.Username</strong>
                                        @if (!string.IsNullOrEmpty(user.FirstName) || !string.IsNullOrEmpty(user.LastName))
                                        {
                                            <br />
                                            <small class="text-muted">@user.FirstName @user.LastName</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @user.Email
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="fas fa-check-circle text-success" title="Email confirmé"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-exclamation-circle text-warning" title="Email non confirmé"></i>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                    @if (user.Roles.Count == 0)
                                    {
                                        <span class="text-muted">Aucun rôle</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsLockedOut)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-lock"></i> Verrouillé
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-unlock"></i> Actif
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.LastLoginAt.HasValue)
                                    {
                                        @user.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Jamais</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="UserEdit" asp-route-id="@user.Id"
                                           class="btn btn-outline-primary" title="Modifier">
                                            <i class="bx bx-edit"></i>
                                        </a> 
                                        <a asp-action="AssignRoles" asp-route-userId="@user.Id"
                                           class="btn btn-outline-info" title="Gérer les rôles">
                                            <i class="bx bx-user"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
