@model TesterLab.Models.ViewModels.AssignRolesViewModel

@{
    ViewData["Title"] = "Assigner des Rôles";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>
                        <i class="fas fa-user-tag"></i> Assigner des Rôles
                    </h3>
                    <p class="mb-0 text-muted">
                        Utilisateur : <strong>@Model.Username</strong> (@Model.Email)
                    </p>
                </div>
                <div class="card-body">
                    <form asp-action="AssignRoles" method="post">
                        <input type="hidden" asp-for="UserId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Rôles disponibles</label>

                            @foreach (var role in Model.AvailableRoles)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox"
                                           name="selectedRoles" value="@role.RoleId"
                                           id="role_@role.RoleId"
                                           checked="@role.IsSelected" />
                                    <label class="form-check-label" for="role_@role.RoleId">
                                        <strong>@role.RoleName</strong>
                                        @if (!string.IsNullOrEmpty(role.Description))
                                        {
                                            <br />
                                            <small class="text-muted">@role.Description</small>
                                        }
                                    </label>
                                </div>
                            }

                            @if (Model.AvailableRoles.Count == 0)
                            {
                                <div class="alert alert-info">
                                    Aucun rôle disponible.
                                    <a asp-action="RoleCreate">Créer un rôle</a>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="UserEdit" asp-route-id="@Model.UserId"
                               class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Retour
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
