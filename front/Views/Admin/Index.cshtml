@model TesterLab.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Administration";
}

<style>
    /* ── Variables ── */
    :root {
        --indigo:        #534AB7;
        --indigo-mid:    #7F77DD;
        --indigo-light:  #EEEDFE;
        --indigo-border: #AFA9EC;
        --amber-bg:      #FAEEDA;
        --amber-border:  #FAC775;
        --amber-text:    #633806;
        --neutral-bg:    #f8f8f8;
        --neutral-border:#e5e5e5;
        --text-primary:  #1a1a1a;
        --text-muted:    #6b7280;
    }

    /* ── Layout ── */
    .dash-wrapper { padding: 2rem 1.5rem; }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }
    .dash-header h2 {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .dash-header h2 i { color: var(--indigo); }
    .dash-meta { font-size: .8rem; color: var(--text-muted); }

    /* ── Stats strip ── */
    .stats-strip {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
        margin-bottom: 1.75rem;
    }
    .stat-tile {
        background: var(--neutral-bg);
        border: 1px solid var(--neutral-border);
        border-radius: 10px;
        padding: 1rem .75rem;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .stat-tile i {
        font-size: 1.1rem;
        color: var(--indigo-mid);
        margin-bottom: 4px;
    }
    .stat-tile.is-danger i { color: #dc3545; }
    .stat-tile .stat-num {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }
    .stat-tile .stat-lbl {
        font-size: .7rem;
        color: var(--text-muted);
        line-height: 1.3;
    }

    /* ── Action cards ── */
    .actions-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 1.75rem;
    }
    .action-tile {
        background: #fff;
        border: 1px solid var(--neutral-border);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 6px;
        transition: border-color .15s;
    }
    .action-tile:hover { border-color: var(--indigo-border); }
    .action-tile-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 2px;
    }
    .action-ico {
        width: 36px; height: 36px;
        border-radius: 8px;
        background: var(--indigo-light);
        color: var(--indigo);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }
    .action-ico.disabled {
        background: var(--neutral-bg);
        color: var(--text-muted);
    }
    .action-tile h6 {
        font-size: .9rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }
    .action-tile p {
        font-size: .78rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.5;
    }
    .btn-indigo {
        margin-top: 6px;
        background: var(--indigo);
        border: none;
        color: #fff;
        font-size: .78rem;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 7px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
        width: fit-content;
        transition: background .15s;
    }
    .btn-indigo:hover { background: #3C3489; color: #fff; text-decoration: none; }
    .btn-disabled-soft {
        margin-top: 6px;
        background: var(--neutral-bg);
        border: 1px solid var(--neutral-border);
        color: var(--text-muted);
        font-size: .78rem;
        padding: 6px 14px;
        border-radius: 7px;
        cursor: not-allowed;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        width: fit-content;
    }

    /* ── Bottom panels ── */
    .panels-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 1.5rem;
    }
    .panel {
        background: #fff;
        border: 1px solid var(--neutral-border);
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .panel-head {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 11px 16px;
        border-bottom: 1px solid var(--neutral-border);
        background: var(--indigo);
    }
    .panel-head i   { font-size: .9rem; color: rgba(255,255,255,.8); }
    .panel-head span { font-size: .85rem; font-weight: 600; color: #fff; }
    .panel-body  { padding: 12px 16px; flex: 1; }
    .panel-foot  { padding: 10px 16px; border-top: 1px solid var(--neutral-border); }

    /* User list */
    .user-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 0;
        border-bottom: 1px solid var(--neutral-border);
    }
    .user-row:last-child { border-bottom: none; }
    .user-name  { font-size: .83rem; font-weight: 600; color: var(--text-primary); }
    .user-email { font-size: .73rem; color: var(--text-muted); margin: 1px 0; }
    .user-time  { font-size: .7rem;  color: var(--text-muted); }
    .pill {
        font-size: .68rem;
        font-weight: 500;
        padding: 3px 9px;
        border-radius: 99px;
    }
    .pill-ok      { background: #f0f0f0; color: #444; }
    .pill-pending { background: var(--amber-bg); color: var(--amber-text); }

    /* Role bars */
    .role-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }
    .role-name  { font-size: .82rem; font-weight: 500; color: var(--text-primary); display:flex; align-items:center; gap:5px; }
    .role-name i { color: var(--indigo-mid); font-size: .8rem; }
    .role-count { font-size: .73rem; color: var(--text-muted); }
    .role-bar-track {
        height: 5px;
        background: var(--neutral-bg);
        border-radius: 99px;
        margin-bottom: 10px;
        overflow: hidden;
    }
    .role-bar-fill {
        height: 100%;
        background: var(--indigo-mid);
        border-radius: 99px;
    }

    /* Link small */
    .link-sm {
        font-size: .78rem;
        color: var(--indigo);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .link-sm:hover { text-decoration: underline; color: var(--indigo); }

    /* Alert */
    .alert-strip {
        background: var(--amber-bg);
        border: 1px solid var(--amber-border);
        border-radius: 10px;
        overflow: hidden;
    }
    .alert-strip-head {
        background: var(--amber-border);
        padding: 9px 16px;
        display: flex;
        align-items: center;
        gap: 7px;
    }
    .alert-strip-head i    { color: var(--amber-text); font-size: .9rem; }
    .alert-strip-head span { font-size: .85rem; font-weight: 600; color: var(--amber-text); }
    .alert-strip-body { padding: 10px 16px; }
    .alert-strip-body ul { margin: 0; padding-left: 1.1rem; }
    .alert-strip-body li { font-size: .82rem; color: var(--amber-text); line-height: 1.6; }
    .alert-strip-body a  { color: var(--indigo); font-weight: 500; }

    /* Empty state */
    .empty-state { text-align:center; padding: 2rem 0; color: var(--text-muted); font-size:.85rem; }
    .empty-state i { font-size: 2rem; display: block; margin-bottom: .5rem; }
</style>

<div class="dash-wrapper">

    <div class="dash-header">
      <h2>
        <i class='bx bx-tachometer'></i>
        Tableau de bord Administration
      </h2>

      <span class="dash-meta">
        <i class='bx bx-time'></i>
        Mis à jour : @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
      </span>
    </div>

    <!-- ── Statistiques ── -->
    <div class="stats-strip">

        <div class="stat-tile">
            <i class='bx bx-group'></i>
            <div class="stat-num">@Model.Statistics.TotalUsers</div>
            <div class="stat-lbl">Utilisateurs total</div>
        </div>

        <div class="stat-tile">
            <i class='bx bx-user-check'></i>
            <div class="stat-num">@Model.Statistics.ActiveUsers</div>
            <div class="stat-lbl">Actifs (@Model.Statistics.ActiveUsersPercentage%)</div>
        </div>

        <div class="stat-tile">
            <i class='bx bx-user-plus'></i>
            <div class="stat-num">@Model.Statistics.NewUsersThisWeek</div>
            <div class="stat-lbl">Nouveaux (7 j)</div>
        </div>

        <div class="stat-tile">
            <i class='bx bx-envelope'></i>
            <div class="stat-num">@Model.Statistics.PendingEmailConfirmation</div>
            <div class="stat-lbl">Email non confirmé</div>
        </div>

        <div class="stat-tile is-danger">
            <i class='bx bx-lock-alt'></i>
            <div class="stat-num">@Model.Statistics.LockedOutUsers</div>
            <div class="stat-lbl">Verrouillés</div>
        </div>

        <div class="stat-tile">
            <i class='bx bxs-shield'></i>
            <div class="stat-num">@Model.Statistics.TotalRoles</div>
            <div class="stat-lbl">Rôles définis</div>
        </div>

    </div>

    <!-- ── Actions rapides ── -->
    <div class="actions-row">

        <div class="action-tile">
            <div class="action-tile-top">
                <div class="action-ico">
                  <i class='bx bx-group'></i>
                </div>
                <h6>Gestion des Utilisateurs</h6>
            </div>
            <p>Gérer les comptes, permissions et verrouillages.</p>
            <a asp-action="Users" class="btn-indigo">
              <i class='bx bx-right-arrow-alt'></i>
              Accéder
            </a>
        </div>

        <div class="action-tile">
            <div class="action-tile-top">
                <div class="action-ico">
                  <i class='bx bx-shield-quarter'></i>
                </div>

                <h6>Gestion des Rôles</h6>
            </div>
            <p>Créer et modifier les rôles et permissions.</p>
            <a asp-action="Roles" class="btn-indigo">
              <i class='bx bx-right-arrow-alt'></i>
              Accéder
            </a>
        </div>

        <div class="action-tile">
            <div class="action-tile-top">
                <div class="action-ico disabled">
                  <i class='bx bx-cog'></i>
                </div>
                <h6>Paramètres Système</h6>
            </div>
            <p>Configuration générale de l'application.</p>
            <a  asp-action="Settings" class="btn-indigo">
              <i class='bx bx-right-arrow-alt'></i>
              Accéder
            </a>
        </div>

    </div>

    <!-- ── Panneaux bas ── -->
    <div class="panels-row">

        <!-- Utilisateurs récents -->
        <div class="panel">
            <div class="panel-head">
              <i class='bx bx-user'></i>
              <span>Utilisateurs Récents</span>
            </div>
            <div class="panel-body">
                @if (Model.RecentUsers.Count > 0)
                {
                    @foreach (var user in Model.RecentUsers)
                    {
                        <div class="user-row">
                            <div>
                                <div class="user-name">@user.Username</div>
                                <div class="user-email">@user.Email</div>
                                <div class="user-time">
                                  <i class='bx bx-time' style="font-size:.65rem;"></i>
                                  @user.TimeAgo
                                </div>
                            </div>
                            @if (user.EmailConfirmed)
                            {
                                <span class="pill pill-ok"><i class="bx bx-check" style="font-size:.6rem;"></i> Confirmé</span>
                            }
                            else
                            {
                                <span class="pill pill-pending">
                                  <i class='bx bx-time' style="font-size:.6rem;"></i>
                                  En attente
                                </span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bx bx-inbox"></i>
                        Aucun utilisateur récent
                    </div>
                }
            </div>
            <div class="panel-foot">
                <a asp-action="Users" class="link-sm">
                  <i class='bx bx-list-ul' style="font-size:.7rem;"></i>
                  Voir tous les utilisateurs
                </a>
            </div>
        </div>

        <!-- Répartition des rôles -->
        <div class="panel">
            <div class="panel-head">
              <i class='bx bx-pie-chart-alt-2'></i>
              <span>Répartition des Rôles</span>
            </div>
            <div class="panel-body">
                @if (Model.RoleSummaries.Count > 0)
                {
                    @foreach (var roleSummary in Model.RoleSummaries)
                    {
                        var percentage = Model.Statistics.TotalUsers > 0
                            ? Math.Round((double)roleSummary.UserCount / Model.Statistics.TotalUsers * 100, 1)
                            : 0;

                        <div class="role-row">
                            <div class="role-name">
                              <i class='bx bxs-shield'></i>
                              @roleSummary.RoleName
                            </div>
                            <div class="role-count">@roleSummary.UserCount util. &mdash; @percentage%</div>
                        </div>
                        <div class="role-bar-track">
                            <div class="role-bar-fill" style="width: @percentage%;"></div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class='bx bx-inbox'></i>
                            Aucun rôle défini
                        <br />
                        <a asp-action="RoleCreate"
                           class="btn-indigo"
                           style="margin-top:.75rem;display:inline-flex;">
                          <i class='bx bx-plus'></i>
                            Créer un rôle
                        </a>
                    </div>
                }
            </div>
            <div class="panel-foot">
                <a asp-action="Roles" class="link-sm">
                  <i class='bx bx-list-ul' style="font-size:.7rem;"></i>
                  Gérer les rôles
                </a>
            </div>
        </div>

    </div>

    <!-- ── Alerte ── -->
    @if (Model.Statistics.PendingEmailConfirmation > 0 || Model.Statistics.LockedOutUsers > 0)
    {
        <div class="alert-strip">
            <div class="alert-strip-head">
              <i class='bx bx-error'></i>
              <span>Actions recommandées</span>
            </div>
            <div class="alert-strip-body">
                <ul>
                    @if (Model.Statistics.PendingEmailConfirmation > 0)
                    {
                        <li>
                            <strong>@Model.Statistics.PendingEmailConfirmation</strong> utilisateur(s)
                            n'ont pas encore confirmé leur email.
                            <a asp-action="Users" asp-route-roleFilter="">Voir la liste</a>
                        </li>
                    }
                    @if (Model.Statistics.LockedOutUsers > 0)
                    {
                        <li>
                            <strong>@Model.Statistics.LockedOutUsers</strong> compte(s)
                            sont actuellement verrouillés.
                            <a asp-action="Users">Gérer les comptes</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        // Auto-refresh toutes les 5 minutes (optionnel)
        // setTimeout(() => location.reload(), 300000);
    </script>
}
