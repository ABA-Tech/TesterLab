@{
    ViewData["Title"] = "Accès refusé";
    Layout = "_CommonMasterLayout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2><i class="bi bi-shield-exclamation"></i> Accès Refusé</h2>
                </div>
                <div class="card-body">
                    <p class="lead">Vous n'avez pas les permissions nécessaires pour accéder à cette page.</p>
                    <p>Si vous pensez qu'il s'agit d'une erreur, contactez un administrateur.</p>

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            <i class="bi bi-house"></i> Retour à l'accueil
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-box-arrow-right"></i> Se déconnecter
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <p class="text-muted small">
                    Connecté en tant que : <strong>@User.Identity?.Name</strong>
                </p>
            </div>
        </div>
    </div>
</div>
