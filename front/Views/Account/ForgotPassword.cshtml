@model TesterLab.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Mot de passe oublié";
    Layout = "_CommonMasterLayout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <h2>Mot de passe oublié</h2>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">
                    Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Envoyer le lien</button>
                    </div>
                </form>

                <hr class="my-4">

                <div class="text-center">
                    <a asp-action="Login">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
