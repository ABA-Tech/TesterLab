@model List<TesterLab.Domain.DTOs.DailyTrendData>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Tendances des exécutions</h5>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary" data-period="7">7 jours</button>
                <button type="button" class="btn btn-outline-secondary active" data-period="14">14 jours</button>
                <button type="button" class="btn btn-outline-secondary" data-period="30">30 jours</button>
            </div>
        </div>
    </div>
    <div class="card-body" style="min-height: 320px;">
        <div id="chartLoading" class="text-center py-5" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="text-muted mt-2">Chargement des données...</p>
        </div>
        @if (Model != null && Model.Any())
        {
            <canvas id="executionTrendsChart" style="height: 300px;"></canvas>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-graph-up text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="text-muted mt-3">Aucune donnée d'exécution disponible</p>
                <small class="text-muted">Les données apparaîtront après les premières exécutions de tests</small>
            </div>
        }
    </div>
</div>

<script>
    const initialTrendsData = @Html.Raw(Model != null && Model.Any() ? Json.Serialize(Model) : "[]");
</script>

