@model List<TesterLab.Domain.Models.TestRun>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Dernières exécutions</h5>
            <a asp-controller="TestRuns" asp-action="Index" class="btn btn-sm btn-outline-primary">Voir tout</a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0">Nom</th>
                            <th class="border-0">Application</th>
                            <th class="border-0">Statut</th>
                            <th class="border-0">Résultats</th>
                            <th class="border-0">Date</th>
                            <th class="border-0"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Model)
                        {
                            <tr>
                                <td class="align-middle">
                                    <strong>@run.Name</strong>
                                    <br />
                                    <small class="text-muted">@run.ExecutionType</small>
                                </td>
                                <td class="align-middle">
                                    @run.Application?.Name
                                </td>
                                <td class="align-middle">
                                    @if (run.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Terminé</span>
                                    }
                                    else if (run.Status == "Running")
                                    {
                                        <span class="badge bg-primary">En cours</span>
                                    }
                                    else if (run.Status == "Failed")
                                    {
                                        <span class="badge bg-danger">Échoué</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@run.Status</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle"></i> @run.PassedCount
                                        </span>
                                        @if (run.FailedCount > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                <i class="bi bi-x-circle"></i> @run.FailedCount
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <small class="text-muted">
                                        @run.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>
                                <td class="align-middle text-end">
                                    <a asp-controller="TestRuns" asp-action="Details" asp-route-id="@run.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Détails
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3">Aucune exécution récente</p>
            </div>
        }
    </div>
</div>
