@model front.Controllers.DashboardViewModel

<div class="row mb-4">
    <!-- Applications -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Applications</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalApplications</h2>
                        <small class="text-success">
                            <i class="bi bi-check-circle-fill"></i> @Model.ActiveApplications actives
                        </small>
                    </div>
                    <div class="text-primary" style="font-size: 2.5rem; opacity: 0.2;">
                        <i class="bi bi-app-indicator"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scénarios de test -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Scénarios de test</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalTestCases</h2>
                        <small class="text-muted">
                            Au total
                        </small>
                    </div>
                    <div class="text-info" style="font-size: 2.5rem; opacity: 0.2;">
                        <i class="bi bi-list-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Taux de réussite -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Taux de réussite</h6>
                        <h2 class="mb-0 fw-bold">@Model.SuccessRate.ToString("F1")%</h2>
                        <small class="@(Model.SuccessRate >= 90 ? "text-success" : Model.SuccessRate >= 70 ? "text-warning" : "text-danger")">
                            @Model.SuccessfulExecutions/@Model.TotalExecutions tests
                        </small>
                    </div>
                    <div class="@(Model.SuccessRate >= 90 ? "text-success" : Model.SuccessRate >= 70 ? "text-warning" : "text-danger")" style="font-size: 2.5rem; opacity: 0.2;">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Jobs planifiés -->
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Jobs actifs</h6>
                        <h2 class="mb-0 fw-bold">@Model.ActiveJobs</h2>
                        <small class="text-muted">
                            Planifiés
                        </small>
                    </div>
                    <div class="text-warning" style="font-size: 2.5rem; opacity: 0.2;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
