@model List<front.Controllers.DailyTrendData>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Tendances des exécutions</h5>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary active" data-period="7">7 jours</button>
                <button type="button" class="btn btn-outline-secondary" data-period="14">14 jours</button>
                <button type="button" class="btn btn-outline-secondary" data-period="30">30 jours</button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <canvas id="executionTrendsChart" height="80"></canvas>
    </div>
</div>

<script>
    const trendsData = @Html.Raw(Json.Serialize(Model));
</script>
